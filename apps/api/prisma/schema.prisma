// ╔══════════════════════════════════════════════════════════════════════════╗
// ║           UniHealth ID (UHID) — Prisma Schema                          ║
// ║           Version: 1.0  |  Date: March 11, 2026                        ║
// ║           Database: Supabase PostgreSQL 15                              ║
// ║           Models: 27  |  Enums: 23                                      ║
// ╚══════════════════════════════════════════════════════════════════════════╝

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  PATIENT
  DOCTOR
  HOSPITAL_STAFF
  HOSPITAL_ADMIN
  INSURANCE_PROVIDER
  SUPER_ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
  UNKNOWN
}

enum RecordType {
  LAB_REPORT
  IMAGING
  PRESCRIPTION
  DISCHARGE_SUMMARY
  VACCINATION
  ECG
  OTHER
}

enum RecordSubType {
  // Lab
  BLOOD_TEST
  URINE_TEST
  LIVER_FUNCTION
  KIDNEY_FUNCTION
  LIPID_PROFILE
  THYROID
  HBA1C
  BLOOD_SUGAR
  COMPLETE_BLOOD_COUNT
  // Imaging
  XRAY
  MRI
  CT_SCAN
  ULTRASOUND
  PET_SCAN
  MAMMOGRAPHY
  // Other
  ECG_RECORDING
  COVID_VACCINE
  ROUTINE_VACCINE
  GENERAL
}

enum ConsentStatus {
  PENDING
  ACTIVE
  REVOKED
  DENIED
  EXPIRED
}

enum ConsentScope {
  ALL
  LAB_REPORT
  IMAGING
  PRESCRIPTION
  DISCHARGE_SUMMARY
  VACCINATION
  ECG
  CLINICAL_NOTES
  EMERGENCY_ONLY
}

enum AppointmentType {
  IN_PERSON
  VIDEO
  PHONE
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ClaimType {
  HOSPITALIZATION
  OUTPATIENT
  SURGERY
  MATERNITY
  DENTAL
  VISION
  CRITICAL_ILLNESS
}

enum ClaimStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  HOLD
  PAID
}

enum StaffType {
  NURSE
  PHARMACIST
  LAB_TECHNICIAN
  RECEPTIONIST
  RADIOLOGIST
  OTHER
}

enum InteractionSeverity {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

enum PharmaCheckType {
  DRUG_INTERACTION
  DRUG_ALLERGY
  DRUG_CONDITION
  DUPLICATE_DRUG
}

enum DrugForm {
  TABLET
  CAPSULE
  SYRUP
  INJECTION
  CREAM
  DROPS
  INHALER
  PATCH
  SUPPOSITORY
  OTHER
}

enum DrugRoute {
  ORAL
  IV
  IM
  TOPICAL
  INHALATION
  SUBLINGUAL
  RECTAL
  NASAL
  OTHER
}

enum NoteVisibility {
  PRIVATE
  HOSPITAL
  PATIENT_VISIBLE
}

enum SummaryType {
  REPORT_DECODER
  CLINICAL_SUMMARY
}

enum EmergencyAccessType {
  QR_SCAN
  SOS
  OVERRIDE
  EMERGENCY_CODE
}

enum QrScanType {
  PUBLIC_SCAN
  DOCTOR_SCAN
  INSURANCE_SCAN
  PATIENT_INITIATED
  SUSPICIOUS_SCAN
}

enum NotificationType {
  CONSENT_REQUEST
  CONSENT_APPROVED
  CONSENT_DENIED
  CONSENT_REVOKED
  CONSENT_EXPIRED
  RECORD_UPLOADED
  PRESCRIPTION_CREATED
  APPOINTMENT_BOOKED
  APPOINTMENT_CONFIRMED
  APPOINTMENT_CANCELLED
  APPOINTMENT_REMINDER
  APPOINTMENT_STARTED
  EMERGENCY_SOS
  EMERGENCY_OVERRIDE
  CLAIM_DECISION
  STAFF_VERIFIED
  GENERAL
}

enum AuditAction {
  // Auth
  LOGIN
  LOGOUT
  FAILED_LOGIN
  PASSWORD_RESET
  EMAIL_VERIFIED
  TOKEN_REFRESHED
  // Records
  RECORD_UPLOADED
  RECORD_VIEWED
  RECORD_DOWNLOADED
  RECORD_DELETED
  // Consent
  CONSENT_REQUESTED
  CONSENT_APPROVED
  CONSENT_DENIED
  CONSENT_REVOKED
  CONSENT_EXPIRED
  // Prescriptions & Clinical
  PRESCRIPTION_CREATED
  PRESCRIPTION_VIEWED
  CLINICAL_NOTE_CREATED
  CLINICAL_NOTE_VIEWED
  PHARMA_CHECK_OVERRIDE
  // Emergency
  EMERGENCY_OVERRIDE
  QR_GENERATED
  QR_USED
  QR_REVOKED
  SOS_ACTIVATED
  EMERGENCY_CODE_USED
  // Admin
  STAFF_VERIFIED
  STAFF_REJECTED
  STAFF_DEACTIVATED
  HOSPITAL_VERIFIED
  HOSPITAL_SUSPENDED
  OVERRIDE_REVIEWED
  // Insurance
  CLAIM_SUBMITTED
  CLAIM_DECISION
  RECORD_VERIFIED
  // AI
  AI_REPORT_GENERATED
  AI_SUMMARY_GENERATED
  // Appointments
  APPOINTMENT_BOOKED
  APPOINTMENT_CANCELLED
  APPOINTMENT_COMPLETED
  VIDEO_ROOM_JOINED
}

enum AuditSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AvailabilityDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

// ─────────────────────────────────────────────────────────────────────────────
// USER & ROLE MODELS
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String
  role             Role
  isEmailVerified  Boolean   @default(false)
  emailVerifyToken String?
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Role profiles (exactly one will be populated per user)
  patient           Patient?
  doctor            Doctor?
  hospitalStaff     HospitalStaff?
  hospitalAdmin     HospitalAdmin?
  insuranceProvider InsuranceProvider?
  superAdmin        SuperAdmin?

  // Notifications (all roles receive these)
  notifications Notification[]

  // QR scan logs (when this user scanned someone else's QR)
  qrScansPerformed QrScanLog[]

  @@map("users")
}

model Patient {
  id                String     @id @default(cuid())
  userId            String     @unique
  uhid              String     @unique
  firstName         String
  lastName          String
  dateOfBirth       DateTime
  gender            Gender
  bloodGroup        BloodGroup @default(UNKNOWN)
  phone             String?
  aadhaarEncrypted  String?
  photoUrl          String?
  allergies         String[]   @default([])
  chronicConditions String[]   @default([])
  address           String?
  city              String?
  state             String?
  pincode           String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Relationships
  medicalRecords   MedicalRecord[]
  prescriptions    Prescription[]
  clinicalNotes    ClinicalNote[]
  consents         Consent[]
  qrCodes          QrCode[]
  emergencyAccesses EmergencyAccess[]
  emergencyContacts EmergencyContact[]
  appointments     Appointment[]
  insuranceClaims  InsuranceClaim[]
  aiSummaries      AiReportSummary[]
  doctorReviews    DoctorReview[]
  qrScanLogs       QrScanLog[]
  pharmaCheckLogs  PharmaCheckLog[]
  familyLinksAsChild   FamilyLink[] @relation("ChildPatient")
  familyLinksAsParent  FamilyLink[] @relation("ParentPatient")

  @@map("patients")
}

model Doctor {
  id                   String   @id @default(cuid())
  userId               String   @unique
  hospitalId           String
  firstName            String
  lastName             String
  specialty            String
  licenseNumber        String   @unique
  qualifications       String[]
  experienceYears      Int      @default(0)
  consultationFee      Float    @default(0.0)
  languages            String[] @default(["English"])
  availableForVideo    Boolean  @default(true)
  availableForInPerson Boolean  @default(true)
  slotDurationMinutes  Int      @default(30)
  isVerified           Boolean  @default(false)
  verifiedAt           DateTime?
  verifiedByAdminId    String?
  rating               Float    @default(0.0)
  totalReviews         Int      @default(0)
  photoUrl             String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospital Hospital @relation(fields: [hospitalId], references: [id])

  // Relationships
  prescriptions     Prescription[]
  clinicalNotes     ClinicalNote[]
  consentsRequested Consent[]
  appointments      Appointment[]
  pharmaCheckLogs   PharmaCheckLog[]
  availability      DoctorAvailability[]
  reviews           DoctorReview[]
  emergencyAccesses EmergencyAccess[]

  @@map("doctors")
}

model HospitalStaff {
  id          String    @id @default(cuid())
  userId      String    @unique
  hospitalId  String
  firstName   String
  lastName    String
  staffType   StaffType
  employeeId  String?
  isVerified  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospital Hospital @relation(fields: [hospitalId], references: [id])

  uploadedRecords MedicalRecord[]

  @@map("hospital_staff")
}

model HospitalAdmin {
  id         String   @id @default(cuid())
  userId     String   @unique
  hospitalId String   @unique
  firstName  String
  lastName   String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospital Hospital @relation(fields: [hospitalId], references: [id])

  @@map("hospital_admins")
}

model InsuranceProvider {
  id            String    @id @default(cuid())
  userId        String    @unique
  companyName   String
  licenseNumber String    @unique
  isVerified    Boolean   @default(false)
  verifiedAt    DateTime?
  createdAt     DateTime  @default(now())

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  consentsRequested Consent[]
  claims          InsuranceClaim[]

  @@map("insurance_providers")
}

model SuperAdmin {
  id        String   @id @default(cuid())
  userId    String   @unique
  firstName String
  lastName  String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("super_admins")
}

model Hospital {
  id                 String    @id @default(cuid())
  name               String
  registrationNumber String    @unique
  address            String
  city               String
  state              String
  pincode            String
  phone              String?
  email              String?
  isVerified         Boolean   @default(false)
  verifiedAt         DateTime?
  isNABH             Boolean   @default(false)
  specialties        String[]  @default([])
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  doctors        Doctor[]
  staff          HospitalStaff[]
  admin          HospitalAdmin?
  appointments   Appointment[]
  medicalRecords MedicalRecord[]
  auditLogs      AuditLog[]

  @@map("hospitals")
}

model EmergencyContact {
  id                     String   @id @default(cuid())
  patientId              String
  name                   String
  relation               String
  phone                  String
  isOnUhid               Boolean  @default(false)
  emergencyContactUhid   String?
  createdAt              DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("emergency_contacts")
}

model FamilyLink {
  id                String   @id @default(cuid())
  patientId         String
  linkedToPatientId String
  relation          String
  canManage         Boolean  @default(false)
  createdAt         DateTime @default(now())

  patient       Patient @relation("ChildPatient",  fields: [patientId],         references: [id])
  linkedPatient Patient @relation("ParentPatient", fields: [linkedToPatientId], references: [id])

  @@map("family_links")
}

// ─────────────────────────────────────────────────────────────────────────────
// MEDICAL DATA MODELS
// ─────────────────────────────────────────────────────────────────────────────

model MedicalRecord {
  id                 String         @id @default(cuid())
  patientId          String
  uploadedByStaffId  String?
  hospitalId         String?
  recordType         RecordType
  subType            RecordSubType?
  title              String
  description        String?
  fileUrl            String
  filePublicId       String
  fileHash           String
  mimeType           String
  fileSize           Int
  extractedText      String?
  recordDate         DateTime?
  tags               String[]       @default([])
  isDeleted          Boolean        @default(false)
  deletedAt          DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  patient         Patient        @relation(fields: [patientId],         references: [id])
  uploadedByStaff HospitalStaff? @relation(fields: [uploadedByStaffId], references: [id])
  hospital        Hospital?      @relation(fields: [hospitalId],        references: [id])

  aiSummaries     AiReportSummary[]
  claimDocuments  ClaimDocument[]

  @@index([patientId])
  @@index([recordType])
  @@index([recordDate(sort: Desc)])
  @@index([isDeleted])
  @@map("medical_records")
}

model Prescription {
  id             String    @id @default(cuid())
  patientId      String
  doctorId       String
  hospitalId     String
  appointmentId  String?
  diagnosis      String
  notes          String?
  followUpDate   DateTime?
  validUntil     DateTime?
  createdAt      DateTime  @default(now())

  patient     Patient      @relation(fields: [patientId],     references: [id])
  doctor      Doctor       @relation(fields: [doctorId],      references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])

  items           PrescriptionItem[]
  pharmaCheckLogs PharmaCheckLog[]

  @@index([patientId])
  @@index([doctorId])
  @@index([createdAt(sort: Desc)])
  @@map("prescriptions")
}

model PrescriptionItem {
  id             String    @id @default(cuid())
  prescriptionId String
  drugName       String
  dosage         String
  form           DrugForm
  frequency      String
  duration       String
  route          DrugRoute
  instructions   String?
  quantity       Int

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@map("prescription_items")
}

model ClinicalNote {
  id                  String         @id @default(cuid())
  patientId           String
  doctorId            String
  appointmentId       String?
  chiefComplaint      String
  symptoms            String[]
  icd10Code           String
  icd10Description    String
  examinationFindings String?
  vitalSigns          Json?
  diagnosis           String
  treatmentPlan       String?
  visibility          NoteVisibility @default(PRIVATE)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  patient     Patient      @relation(fields: [patientId],     references: [id])
  doctor      Doctor       @relation(fields: [doctorId],      references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])

  @@index([patientId])
  @@index([doctorId])
  @@map("clinical_notes")
}

// ─────────────────────────────────────────────────────────────────────────────
// ACCESS CONTROL MODELS
// ─────────────────────────────────────────────────────────────────────────────

model Consent {
  id                  String        @id @default(cuid())
  patientId           String
  grantedToType       String
  doctorId            String?
  insuranceProviderId String?
  scope               ConsentScope[]
  purpose             String
  status              ConsentStatus @default(PENDING)
  isTemporary         Boolean       @default(true)
  durationHours       Int?
  expiresAt           DateTime?
  otpVerified         Boolean       @default(false)
  otpVerifiedAt       DateTime?
  requestedAt         DateTime      @default(now())
  grantedAt           DateTime?
  revokedAt           DateTime?

  patient           Patient            @relation(fields: [patientId],           references: [id])
  doctor            Doctor?            @relation(fields: [doctorId],            references: [id])
  insuranceProvider InsuranceProvider? @relation(fields: [insuranceProviderId], references: [id])

  @@index([patientId])
  @@index([status])
  @@index([expiresAt])
  @@index([doctorId])
  @@map("consents")
}

model QrCode {
  id               String         @id @default(cuid())
  patientId        String
  jti              String         @unique
  scope            ConsentScope[]
  tier             Int            @default(1)
  isOneTime        Boolean        @default(false)
  isEmergencyCard  Boolean        @default(false)
  label            String?
  expiresAt        DateTime
  usedAt           DateTime?
  usedByDoctorId   String?
  isRevoked        Boolean        @default(false)
  revokedAt        DateTime?
  revokedReason    String?
  createdAt        DateTime       @default(now())

  patient   Patient      @relation(fields: [patientId], references: [id])
  scanLogs  QrScanLog[]

  @@index([patientId])
  @@index([jti])
  @@map("qr_codes")
}

model QrScanLog {
  /// INSERT-ONLY — never update or delete
  id                String     @id @default(cuid())
  qrCodeId          String
  patientId         String
  tier              Int
  scanType          QrScanType
  scannedById       String?
  scannerName       String?
  scannerUhidId     String?
  organization      String?
  ipAddress         String?
  location          String?
  isSuspicious      Boolean    @default(false)
  suspicionReason   String?
  reportedByPatient Boolean    @default(false)
  scannedAt         DateTime   @default(now())

  qrCode    QrCode @relation(fields: [qrCodeId],  references: [id])
  patient   Patient @relation(fields: [patientId], references: [id])
  scannedBy User?   @relation(fields: [scannedById], references: [id])

  @@index([qrCodeId])
  @@index([patientId])
  @@index([scannedById])
  @@index([scannedAt])
  @@map("qr_scan_logs")
}

model EmergencyAccess {
  id                       String              @id @default(cuid())
  patientId                String
  accessedByDoctorId       String?
  accessType               EmergencyAccessType
  reason                   String?
  reasonType               String?
  latitude                 Float?
  longitude                Float?
  emergencyCode            String?
  emergencyCodeExpiresAt   DateTime?
  expiresAt                DateTime
  isActive                 Boolean             @default(true)
  cancelledAt              DateTime?
  createdAt                DateTime            @default(now())

  patient          Patient @relation(fields: [patientId],          references: [id])
  accessedByDoctor Doctor? @relation(fields: [accessedByDoctorId], references: [id])

  @@map("emergency_accesses")
}

// ─────────────────────────────────────────────────────────────────────────────
// AI & LOGGING MODELS
// ─────────────────────────────────────────────────────────────────────────────

model AiReportSummary {
  id             String      @id @default(cuid())
  recordId       String?
  patientId      String
  summaryType    SummaryType
  summaryText    String
  structuredData Json?
  riskLevel      String?
  modelUsed      String
  tokensUsed     Int?
  generatedAt    DateTime
  updatedAt      DateTime    @updatedAt

  record  MedicalRecord? @relation(fields: [recordId],  references: [id])
  patient Patient        @relation(fields: [patientId], references: [id])

  @@map("ai_report_summaries")
}

model PharmaCheckLog {
  id             String              @id @default(cuid())
  prescriptionId String?
  doctorId       String
  patientId      String
  checkType      PharmaCheckType
  severity       InteractionSeverity
  drugs          String[]
  mechanism      String
  overridden     Boolean             @default(false)
  overrideReason String?
  createdAt      DateTime            @default(now())

  prescription Prescription? @relation(fields: [prescriptionId], references: [id])
  doctor       Doctor        @relation(fields: [doctorId],       references: [id])
  patient      Patient       @relation(fields: [patientId],      references: [id])

  @@map("pharma_check_logs")
}

/// INSERT-ONLY — Never UPDATE or DELETE rows in this table.
model AuditLog {
  id         String        @id @default(cuid())
  action     AuditAction
  severity   AuditSeverity
  actorId    String
  actorRole  Role
  targetId   String?
  targetType String?
  hospitalId String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime      @default(now())

  hospital Hospital? @relation(fields: [hospitalId], references: [id])

  @@index([actorId])
  @@index([targetId])
  @@index([hospitalId])
  @@index([createdAt(sort: Desc)])
  @@index([action])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// FINANCIAL MODELS
// ─────────────────────────────────────────────────────────────────────────────

model InsuranceClaim {
  id                  String      @id @default(cuid())
  claimNumber         String      @unique
  patientId           String
  insuranceProviderId String
  policyNumber        String?
  claimType           ClaimType
  diagnosis           String
  icd10Code           String
  admissionDate       DateTime?
  dischargeDate       DateTime?
  hospitalName        String
  claimedAmount       Float
  approvedAmount      Float?
  currency            String      @default("INR")
  status              ClaimStatus @default(SUBMITTED)
  fraudScore          Int?
  fraudFlags          Json?
  notes               String?
  settlementDate      DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  patient           Patient           @relation(fields: [patientId],           references: [id])
  insuranceProvider InsuranceProvider @relation(fields: [insuranceProviderId], references: [id])

  documents ClaimDocument[]

  @@index([patientId])
  @@index([insuranceProviderId])
  @@index([status])
  @@map("insurance_claims")
}

model ClaimDocument {
  id               String    @id @default(cuid())
  claimId          String
  documentType     String
  fileUrl          String
  fileHash         String
  originalRecordId String?
  isVerified       Boolean   @default(false)
  verifiedAt       DateTime?
  uploadedAt       DateTime  @default(now())

  claim          InsuranceClaim @relation(fields: [claimId],          references: [id], onDelete: Cascade)
  originalRecord MedicalRecord? @relation(fields: [originalRecordId], references: [id])

  @@map("claim_documents")
}

// ─────────────────────────────────────────────────────────────────────────────
// TELEHEALTH & NOTIFICATIONS MODELS
// ─────────────────────────────────────────────────────────────────────────────

model Appointment {
  id                 String            @id @default(cuid())
  patientId          String
  doctorId           String
  hospitalId         String
  scheduledAt        DateTime
  type               AppointmentType
  status             AppointmentStatus @default(SCHEDULED)
  chiefComplaint     String?
  notes              String?
  cancelReason       String?
  cancelledBy        String?
  confirmationNumber String            @unique
  videoRoomName      String?
  completedAt        DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  patient  Patient  @relation(fields: [patientId],  references: [id])
  doctor   Doctor   @relation(fields: [doctorId],   references: [id])
  hospital Hospital @relation(fields: [hospitalId], references: [id])

  prescriptions Prescription[]
  clinicalNotes ClinicalNote[]
  review        DoctorReview?

  @@unique([doctorId, scheduledAt])
  @@index([patientId])
  @@index([status])
  @@index([scheduledAt])
  @@map("appointments")
}

model DoctorAvailability {
  id          String          @id @default(cuid())
  doctorId    String
  dayOfWeek   AvailabilityDay
  startTime   String
  endTime     String
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, dayOfWeek])
  @@map("doctor_availability")
}

model DoctorReview {
  id            String   @id @default(cuid())
  doctorId      String
  patientId     String
  appointmentId String   @unique
  rating        Int
  comment       String?
  isAnonymous   Boolean  @default(false)
  createdAt     DateTime @default(now())

  doctor      Doctor      @relation(fields: [doctorId],      references: [id])
  patient     Patient     @relation(fields: [patientId],     references: [id])
  appointment Appointment @relation(fields: [appointmentId], references: [id])

  @@unique([patientId, appointmentId])
  @@index([doctorId])
  @@map("doctor_reviews")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  metadata  Json?
  createdAt DateTime         @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([expiresAt])
  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────────────────────
// LOOKUP / REFERENCE DATA MODELS
// ─────────────────────────────────────────────────────────────────────────────

/// Seeded from OpenFDA API. Drug names stored normalized (lowercase, trimmed).
/// Always stored so drug1Name < drug2Name alphabetically.
model DrugInteraction {
  id             String              @id @default(cuid())
  drug1Name      String
  drug2Name      String
  severity       InteractionSeverity
  mechanism      String
  clinicalEffect String
  management     String?
  source         String              @default("OpenFDA")
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([drug1Name, drug2Name])
  @@index([drug1Name])
  @@index([drug2Name])
  @@map("drug_interactions")
}

/// Seeded once using the `icd10-codes` npm package (~70,000 codes). No API needed.
model Icd10Code {
  id          String   @id @default(cuid())
  code        String   @unique
  description String
  category    String?
  isActive    Boolean  @default(true)

  @@index([category])
  @@map("icd10_codes")
}
